# Leave unset for the browser-local demo. Never put provider keys in NEXT_PUBLIC variables.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
GEMINI_API_KEY=
# For new projects. Legacy accounts can opt into gemini-2.5-flash if still enabled.
GEMINI_MODEL=gemini-3.8-flash
PERPLEXITY_API_KEY=
PERPLEXITY_PRESET=fast
